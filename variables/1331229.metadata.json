  "origins": [
    {
      "id": 28218,
      "title": "RioMarkers: Aid (ODA) activities targeting global environmental objectives",
      "description": "This dataset contains bilateral commitment data on aid in support of environmental sustainability and aid to biodiversity, climate change mitigation, climate change adaptation and desertification from the Development Assistance Committee (DAC) Creditor Reporting System (CRS) database.\n\nIn their reporting to the DAC CRS, donors are requested to indicate for each activity whether it targets environment and the Rio Conventions (biodiversity, climate change mitigation, climate change adaptation and desertification) or not. A scoring system of three values is used, in which aid activities are marked as targeting environment as the \"principal\" or \"significant\" objective, or not at all. The same activity can be marked for several objectives, so caution should be used to avoid double-counting.\n\nThe markers on biodiversity, climate change mitigation and desertification were introduced in 1998, and the marker on climate change adaptation applies to flows from 2010 onwards.",
      "producer": "OECD",
      "citationFull": "OECD (2026). RioMarkers: Aid (ODA) activities targeting global environmental objectives. OECD Data Explorer.",
      "urlMain": "https://data-explorer.oecd.org/vis?lc=en&df[ds]=dsDisseminateFinalDMZ&df[id]=DSD_RIOMRKR%40DF_RIOMARKERS&df[ag]=OECD.DCD.FSD",
      "dateAccessed": "2026-10-22",
