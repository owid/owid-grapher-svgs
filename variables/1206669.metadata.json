  "origins": [
    {
      "id": 14891,
      "titleSnapshot": "GGDC 10-sector database - Share of industry in GDP at constant 2005 prices",
      "title": "GGDC 10-sector database",
      "descriptionSnapshot": "The only changes we applied to the GGDC 10-sector database were: (i) dropping observations for GDP shares in Peru 1950–1985 since these are reported as negative in the original; and (ii) dropping observations for GDP shares in the Netherlands 1949–1959, since these are comparable to the period after 1960, as suggested by a marked jump in levels in the original series.",
      "description": "The GGDC 10-sector database provides a long-run, internationally comparable dataset on sectoral productivity performance for 10 broad sectors of the economy, covering Asian, Latin American, and African countries as well as the US and Europe.",
      "producer": "Groningen Growth and Development Centre",
      "citationFull": "Timmer, M. P., de Vries, G. J., and de Vries, K. (2015). Patterns of structural change in developing countries. In J. Weiss, & M. Tribe (Eds.), Routledge Handbook of Industry and Development (pp. 65–83). Routledge.",
      "attributionShort": "GGDC",
      "urlMain": "http://www.rug.nl/ggdc/productivity/10-sector/",
      "dateAccessed": "2017-08-03",
      "datePublished": "2015"
