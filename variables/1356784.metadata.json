  "shortName": "emissions_total_per_unit_energy",
  "catalogPath": "grapher/gcp/2026-11-10/global_carbon_budget/global_carbon_budget#emissions_total_per_unit_energy",
  "descriptionShort": "Carbon dioxide (CO₂) emitted per unit of [total energy supply](#dod:total-energy-supply), measured in grams of CO₂ per [kilowatt-hour](#dod:watt-hours).",
  "descriptionProcessing": "- Global emissions are converted from tonnes of carbon to tonnes of carbon dioxide (CO₂) using a factor of 3.664. This is the conversion factor [recommended by the Global Carbon Project](https://globalcarbonbudget.org/download/2454/). It reflects that one tonne of carbon, when fully oxidized, forms 3.664 tonnes of CO₂, based on the relative molecular weights of carbon and oxygen in CO₂.\n- Emissions from the 1991 Kuwaiti oil fires are included in Kuwait's emissions for that year.",
  "type": "float",
  "patchConfigIdETL": "01a1c46e-0fe1-74d6-b88c-0072c919580c",
  "dataChecksum": "8771837993636836970",
  "metadataChecksum": "-4725349842772490687",
